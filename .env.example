# Claude (required for answering). Get a key at https://console.anthropic.com
ANTHROPIC_API_KEY=sk-ant-...

# Optional: override the model (default: claude-sonnet-5)
MODEL=claude-sonnet-5

# Optional: LangSmith tracing, for an auditable trace of every step
LANGSMITH_API_KEY=
LANGSMITH_TRACING=true
LANGSMITH_PROJECT=grounded-research-assistant
